# Copy to .env and edit. Never commit .env.
# Generate a key with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=backend,localhost,127.0.0.1
FRONTEND_PORT=8080
# Upload limit in bytes (default 200 MiB). If you raise it, also raise client_max_body_size in frontend/nginx.conf.
MAX_UPLOAD_BYTES=209715200
